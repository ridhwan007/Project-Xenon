# Environment variables for ASM Scanner
# Copy this file to .env and fill in your API keys

# ProjectDiscovery Chaos API key for enhanced subdomain discovery
# Get your key from: https://chaos.projectdiscovery.io/
CHAOS_API_KEY=

# Shodan API key for additional reconnaissance
# Get your key from: https://account.shodan.io/
SHODAN_API_KEY=

# Optional: Configure subfinder with additional API keys
# These should be configured in subfinder's provider-config.yaml
